# Copia este archivo a .env y ajusta los valores.
# cp .env.example .env   (Mac/Linux)
# copy .env.example .env (Windows)

# ── Base de datos ────────────────────────────────────────────────
# SQLite (desarrollo): el archivo se crea en el directorio desde el que arrancas uvicorn
DATABASE_URL=sqlite:///./tizon.db

# PostgreSQL (producción): descomenta y completa
# DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombre_bd

# ── JWT (obligatorio cambiar en producción) ──────────────────────
# Genera uno seguro: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-en-produccion

# ── CORS ─────────────────────────────────────────────────────────
# En producción usa tu dominio exacto, ej: https://app.tudominio.com
CORS_ORIGINS=*
