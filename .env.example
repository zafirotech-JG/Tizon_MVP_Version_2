# ── Base de datos ────────────────────────────────────────────────
# SQLite local (por defecto — no requiere nada extra)
DATABASE_URL=sqlite:///./tizon.db

# PostgreSQL en producción (Supabase, Railway, etc.)
# DATABASE_URL=postgresql://user:password@host:5432/tizon

# ── Seguridad JWT ────────────────────────────────────────────────
# Genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=8a423c2cb2d13555cd37503ebbe0451989840b0fdb9d6d36ddff5b6d89befcc8

# ── CORS ─────────────────────────────────────────────────────────
# En producción pon tu dominio exacto, ej: https://tizon.tudominio.com
CORS_ORIGINS=*

# ── Variables ELIMINADAS (ya no se usan) ─────────────────────────
# SPREADSHEET_ID     ← reemplazado por DATABASE_URL
# CREDENTIALS_PATH   ← reemplazado por DATABASE_URL
# GOOGLE_CREDENTIALS_JSON ← reemplazado por DATABASE_URL
# ADMIN_USER         ← reemplazado por registro de tenants
# ADMIN_PASSWORD     ← reemplazado por registro de tenants
