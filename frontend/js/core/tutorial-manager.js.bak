let driverInstance = null;

/**
 * Inicia el tutorial según el rol del usuario
 * @param {string} rol - 'owner', 'manager', 'cajero', etc.
 */
function startTutorial(rol) {
  // Determinar qué tour mostrar
  let tourConfig = TOURS.cajero;
  
  if (rol === 'owner' || rol === 'super_admin') {
    tourConfig = TOURS.owner;
  } else if (rol === 'manager') {
    tourConfig = TOURS.manager;
  }
  
  // Verificar si ya se completó el tutorial
  const tutorialCompleted = localStorage.getItem(`tutorial_completed_${rol}`);
  if (tutorialCompleted) {
    console.log(`[Tutorial] Ya completado para rol: ${rol}`);
    return;
  }
  
  // Inicializar Driver.js
  if (typeof window.driver === 'undefined') {
    console.error('[Tutorial] Driver.js no cargado');
    showToast('Cargando tutorial...', 'info');
    return;
  }
  
  const driver = window.driver.js.driver;
  
  driverInstance = driver({
    showProgress: true,
    showButtons: ['next', 'previous', 'close'],
    allowClose: true,
    overlayClickNext: false,
    stagePadding: 4,
    popoverClass: 'zafiro-driver-theme',
    steps: tourConfig.steps,
    onDestroyStarted: () => {
      if (!driverInstance.hasNextStep()) {
        // Último paso completado
        completeTutorial(rol);
      }
      driverInstance.destroy();
    }
  });
  
  // Iniciar con delay para asegurar que DOM esté listo
  setTimeout(() => {
    driverInstance.drive();
  }, 500);
}

/**
 * Marca el tutorial como completado
 */
function completeTutorial(rol) {
  localStorage.setItem(`tutorial_completed_${rol}`, 'true');
  localStorage.setItem(`tutorial_completed_at_${rol}`, new Date().toISOString());
  
  showToast('¡Tutorial completado! 🎉', 'success');
  
  // Llamar API para marcar en backend (opcional)
  try {
    const token = localStorage.getItem('zafiro_token');
    if (token) {
      fetch('/api/v3/onboarding/tutorial', {
        method: 'PATCH',
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ completado: true })
      });
    }
  } catch (e) {
    // Silenciar errores de red
  }
}

/**
 * Reinicia el tutorial (para testing o "Ver de nuevo")
 */
function resetTutorial(rol) {
  localStorage.removeItem(`tutorial_completed_${rol}`);
  localStorage.removeItem(`tutorial_completed_at_${rol}`);
  startTutorial(rol);
}

/**
 * Muestra el panel de FAQs
 * @param {string} rol - Rol del usuario
 * @param {string} contexto - 'global', 'pos', 'inventario', etc.
 */
function showFAQ(rol, contexto = 'global') {
  const panel = document.getElementById('faq-panel');
  if (!panel) return;
  
  // Filtrar FAQs por rol y contexto
  let faqs = [];
  
  // FAQs globales aplicables al rol
  if (FAQS.global) {
    faqs = faqs.concat(FAQS.global.filter(f => f.roles.includes(rol)));
  }
  
  // FAQs específicas del contexto
  const contextKey = rol === 'cajero' ? 'cajero' : 'admin';
  if (FAQS[contextKey]) {
    faqs = faqs.concat(FAQS[contextKey].filter(f => f.roles.includes(rol)));
  }
  
  // Renderizar panel
  panel.innerHTML = `
    <div class="faq-overlay" onclick="closeFAQ()"></div>
    <div class="faq-container">
      <div class="faq-header">
        <h3><i class="ph ph-question"></i> Preguntas Frecuentes</h3>
        <button class="btn-icon" onclick="closeFAQ()"><i class="ph ph-x"></i></button>
      </div>
      <div class="faq-content">
        ${faqs.length === 0 ? '<p class="text-secondary">No hay FAQs disponibles.</p>' : ''}
        ${faqs.map((faq, idx) => `
          <div class="faq-item">
            <button class="faq-question" onclick="toggleFAQ(${idx})">
              <span>${faq.q}</span>
              <i class="ph ph-caret-down" id="faq-icon-${idx}"></i>
            </button>
            <div class="faq-answer" id="faq-answer-${idx}" style="display: none;">
              <p>${faq.a}</p>
            </div>
          </div>
        `).join('')}
      </div>
      <div class="faq-footer">
        <button class="btn btn-ghost btn-sm" onclick="startTutorial('${rol}')">
          <i class="ph ph-play-circle"></i> Ver tutorial de nuevo
        </button>
        <a href="https://zafiro.co/soporte" target="_blank" class="btn btn-zafiro btn-sm">
          <i class="ph ph-chat-circle"></i> Contactar soporte
        </a>
      </div>
    </div>
  `;
  
  panel.classList.remove('hidden');
  
  // Animación de entrada
  setTimeout(() => {
    panel.querySelector('.faq-container').classList.add('active');
  }, 10);
}

/**
 * Cierra el panel de FAQs
 */
function closeFAQ() {
  const panel = document.getElementById('faq-panel');
  if (!panel) return;
  
  panel.querySelector('.faq-container').classList.remove('active');
  setTimeout(() => {
    panel.classList.add('hidden');
  }, 300);
}

/**
 * Toggle individual FAQ item
 */
function toggleFAQ(idx) {
  const answer = document.getElementById(`faq-answer-${idx}`);
  const icon = document.getElementById(`faq-icon-${idx}`);
  
  if (answer.style.display === 'none') {
    answer.style.display = 'block';
    icon.classList.replace('ph-caret-down', 'ph-caret-up');
  } else {
    answer.style.display = 'none';
    icon.classList.replace('ph-caret-up', 'ph-caret-down');
  }
}

/**
 * Muestra un toast notification
 */
function showToast(message, type = 'info') {
  const container = document.getElementById('toast-container');
  if (!container) return;
  
  const toast = document.createElement('div');
  toast.className = `toast toast-${type}`;
  toast.innerHTML = `
    <i class="ph ${type === 'success' ? 'ph-check-circle' : type === 'error' ? 'ph-warning-circle' : 'ph-info'}"></i>
    <span>${message}</span>
  `;
  
  container.appendChild(toast);
  
  setTimeout(() => toast.classList.add('show'), 10);
  setTimeout(() => {
    toast.classList.remove('show');
    setTimeout(() => toast.remove(), 300);
  }, 3000);
}

// Auto-iniciar tutorial si es primera vez
document.addEventListener('DOMContentLoaded', () => {
  // Verificar si hay usuario logueado
  const token = localStorage.getItem('zafiro_token');
  if (!token) return;
  
  // Obtener rol del usuario (del token o localStorage)
  let user = null;
  try {
    const userStr = localStorage.getItem('zafiro_user');
    if (userStr) user = JSON.parse(userStr);
  } catch (e) {
    console.error('[Tutorial] Error parsing user:', e);
  }
  
  if (user?.rol) {
    const tutorialCompleted = localStorage.getItem(`tutorial_completed_${user.rol}`);
    if (!tutorialCompleted) {
      // Delay para dejar que la UI cargue
      setTimeout(() => {
        startTutorial(user.rol);
      }, 1000);
    }
  }
});

// Exports
export { startTutorial, resetTutorial, showFAQ, closeFAQ, completeTutorial };

// Globals para onclick handlers
window.closeFAQ = closeFAQ;
window.toggleFAQ = toggleFAQ;
